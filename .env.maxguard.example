QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2400
CACHE_DRIVER=file
SESSION_DRIVER=file

MAXGUARD_ROUTE_MIDDLEWARE=auth
MAXGUARD_PROVIDE_AUTH_ROUTES=true
MAXGUARD_QUEUE=scans
MAXGUARD_PAGE_QUEUE=scan-pages
MAXGUARD_FINALIZE_QUEUE=scan-finalize
MAXGUARD_PAGE_BATCH_SIZE=10
MAXGUARD_PAGE_WORKERS=6
MAXGUARD_ORCHESTRATOR_TIMEOUT=900
MAXGUARD_PAGE_JOB_TIMEOUT=1800
MAXGUARD_FINALIZE_TIMEOUT=900
MAXGUARD_EVIDENCE_DISK=local
MAXGUARD_EVIDENCE_PREFIX=maxguard/evidence
MAXGUARD_USER_AGENT="MaxGuard-ComplianceBot/1.0 (+https://your-domain.example/bot)"
MAXGUARD_MAX_PAGES=0
MAXGUARD_MAX_DISCOVERED_URLS=100000
MAXGUARD_MAX_SITEMAPS=1000
MAXGUARD_FOLLOW_INTERNAL_LINKS=true
MAXGUARD_WORKER_MEMORY=1024
MAXGUARD_MAX_REDIRECTS=4
MAXGUARD_TIMEOUT=20
MAXGUARD_CONNECT_TIMEOUT=8
MAXGUARD_MAX_RESPONSE_BYTES=5000000
MAXGUARD_HOST_RPS=1.5
MAXGUARD_RESPECT_ROBOTS=true
MAXGUARD_AD_PAGE_EMPTY_CONTENT_WORDS=80
MAXGUARD_AD_PAGE_THIN_CONTENT_WORDS=300

# Optional semantic AI review. Never commit a real key.
MAXGUARD_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Set provider=openai to use this legacy-compatible key instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MAXGUARD_AI_ENABLED=false
MAXGUARD_AI_MODEL=gemini-2.5-flash
MAXGUARD_AI_REASONING_EFFORT=low
MAXGUARD_AI_OUTPUT_LANGUAGE=Vietnamese
MAXGUARD_AI_MAX_INPUT_CHARS=12000
MAXGUARD_AI_MAX_OUTPUT_TOKENS=1800
MAXGUARD_AI_MAX_PAGES_PER_SCAN=100
MAXGUARD_AI_MIN_CONFIDENCE=70
MAXGUARD_AI_CONNECT_TIMEOUT=10
MAXGUARD_AI_TIMEOUT=90

# Sightengine text moderation. Keep real credentials only in .env.
SIGHTENGINE_ENABLED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELS=general,self-harm
SIGHTENGINE_VIOLATION_THRESHOLD=0.55

# Google OAuth / GA4 Data API. Redirect URI example:
# http://maxguard.test/integrations/ga4/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MAXGUARD_GA4_TRAFFIC_DAYS=7
MAXGUARD_GA4_MAX_ROWS=1000
